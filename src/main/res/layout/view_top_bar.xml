<?xml version="1.0" encoding="utf-8"?>
<!--
    SHARED TOP BAR. Included at the top of every screen:
        <include layout="@layout/view_top_bar" />
    BaseActivity fills in the day and time automatically and pads it under
    the system status bar. Do not change the view ids.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_bar"
    style="@style/Widget.CampusNav.TopBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_top_day"
        style="@style/Widget.CampusNav.TopBarText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start"
        tools:text="Mon" />

    <ImageView
        android:id="@+id/iv_top_weather"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/cd_weather"
        android:src="@drawable/ic_weather_sunny"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/tv_top_time"
        style="@style/Widget.CampusNav.TopBarText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        tools:text="10:30 AM" />

</LinearLayout>
