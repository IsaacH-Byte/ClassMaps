<?xml version="1.0" encoding="utf-8"?>


<!--
  REUSABLE STYLES:
    * BaseSurveyText / SurveyHeadingText / SwitchSideLabel : Shared TextView typography.
    * StarButtonStyle / HazardOptionButton                 : Borderless option buttons.
    * PrimaryActionButton / SecondaryActionButton          : Contained vs. text action hierarchy.
-->


<resources>
    <!-- Base body/label text style (16sp+ per mobile typography guidelines) -->
    <style name="BaseSurveyText">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Inherited heading style for banners and titles -->
    <style name="SurveyHeadingText" parent="BaseSurveyText">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Labels flanking each Switch ("No" / "Yes") -->
    <style name="SwitchSideLabel" parent="BaseSurveyText">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <!-- Borderless style for the 5 star rating buttons -->
    <style name="StarButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Borderless style for the scrollable hazard type list buttons -->
    <style name="HazardOptionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Primary contained button style (Submit, Select Location) -->
    <style name="PrimaryActionButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Secondary borderless text button style (Maybe Later) -->
    <style name="SecondaryActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#3F51B5</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>